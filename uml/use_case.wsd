
@startuml
' CSC3020 - Software Engineering Fundamentals
' Instructor: Thyago Mota
' Student(s): Juvia Archuleta, Leigha Lennon
' Description: Project 3 - TaskTrack

left to right direction

actor "Visitor" as Visitor
actor "Registered User" as User

rectangle "TaskTrack - Task Management System" {

    usecase "Register Account" as UC1
    usecase "Log In" as UC2
    usecase "Log Out" as UC3
    usecase "View Tasks" as UC4
    usecase "Add Task" as UC5
    usecase "Complete Task" as UC6
    usecase "Delete Task" as UC7

}

Visitor --> UC1
Visitor --> UC2

User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7

@enduml